class ResponseComposerEngine:
    """
    Phase 74

    Executive Narrative Intelligence

    Converts Aura's intelligence pipeline into
    a business-aware executive response.
    """

    def compose(
        self,
        goal: str,
        executive_synthesis: dict,
        market_intelligence: dict,
        competitive_intelligence: dict,
        dynamic_reasoning: dict,
        operational_intelligence: dict,
        simulation: dict,
        business_understanding: dict
    ):

        business_understanding = business_understanding or {}

        business_dna = business_understanding.get(
            "business_dna",
            {}
        )

        business_context = business_understanding.get(
            "business_context",
            {}
        )

        summary = self._build_executive_summary(
            goal,
            executive_synthesis,
            business_dna,
            business_context
        )

        confidence = executive_synthesis.get(
            "confidence",
            50
        )

        findings = self._build_findings(
            market_intelligence,
            competitive_intelligence,
            dynamic_reasoning,
            business_dna
        )

        recommendations = self._build_recommendations(
            dynamic_reasoning,
            operational_intelligence
        )

        risks = self._build_risks(
            executive_synthesis,
            dynamic_reasoning
        )

        next_steps = operational_intelligence.get(
            "operations_next_steps",
            []
        )

        best_strategy = simulation.get(
            "best_strategy",
            {}
        )

        return {

            "executive_summary": summary,

            "organization":
                business_context.get(
                    "organization_name"
                ),

            "workspace":
                business_context.get(
                    "workspace_name"
                ),

            "business_stage":
                business_dna.get(
                    "business_stage"
                ),

            "mission":
                business_dna.get(
                    "mission"
                ),

            "business_goals":
                business_dna.get(
                    "business_goals"
                ),

            "current_challenges":
                business_dna.get(
                    "current_challenges"
                ),

            "key_findings":
                findings,

            "recommendations":
                recommendations,

            "risks":
                risks,

            "next_steps":
                next_steps,

            "recommended_strategy":
                best_strategy,

            "confidence":
                confidence
        }

    # ====================================================
    # Executive Narrative
    # ====================================================

    def _build_executive_summary(
        self,
        goal,
        executive_synthesis,
        business_dna,
        business_context
    ):

        recommendation = executive_synthesis.get(
            "executive_recommendation",
            "No recommendation available."
        )

        organization = business_context.get(
            "organization_name"
        )

        workspace = business_context.get(
            "workspace_name"
        )

        mission = business_dna.get(
            "mission"
        )

        stage = business_dna.get(
            "business_stage"
        )

        goals = business_dna.get(
            "business_goals"
        )

        challenge = business_dna.get(
            "current_challenges"
        )

        summary = recommendation

        if organization:

            summary += (
                f"\n\nOrganization: {organization}"
            )

        if workspace:

            summary += (
                f"\nWorkspace: {workspace}"
            )

        if mission:

            summary += (
                f"\nMission: {mission}"
            )

        if stage:

            summary += (
                f"\nBusiness Stage: {stage}"
            )

        if goals:

            summary += (
                f"\nBusiness Goals: {goals}"
            )

        if challenge:

            summary += (
                f"\nCurrent Challenges: {challenge}"
            )

        summary += (

            "\n\nThis recommendation is based on "

            "your organization's business context, "

            "market intelligence, strategic analysis "

            "and operational understanding."

        )

        return summary

    # ====================================================
    # Findings
    # ====================================================

    def _build_findings(
        self,
        market_intelligence,
        competitive_intelligence,
        dynamic_reasoning,
        business_dna
    ):

        findings = []

        opportunity = market_intelligence.get(
            "opportunity_score"
        )

        if opportunity is not None:

            findings.append(
                f"Market opportunity score: {opportunity}"
            )

        competition = market_intelligence.get(
            "competition_level"
        )

        if competition:

            findings.append(
                f"Competition level: {competition}"
            )

        bottleneck = dynamic_reasoning.get(
            "current_bottleneck"
        )

        if bottleneck:

            findings.append(
                bottleneck
            )

        stage = business_dna.get(
            "business_stage"
        )

        if stage:

            findings.append(
                f"Business stage: {stage}"
            )

        challenge = business_dna.get(
            "current_challenges"
        )

        if challenge:

            findings.append(
                f"Primary challenge: {challenge}"
            )

        return findings

    # ====================================================
    # Recommendations
    # ====================================================

    def _build_recommendations(
        self,
        dynamic_reasoning,
        operational_intelligence
    ):

        recommendations = []

        priority = dynamic_reasoning.get(
            "current_priority"
        )

        if priority:

            recommendations.append(
                priority
            )

        move = operational_intelligence.get(
            "recommended_operational_move"
        )

        if move:

            recommendations.append(
                move
            )

        return recommendations

    # ====================================================
    # Risks
    # ====================================================

    def _build_risks(
        self,
        executive_synthesis,
        dynamic_reasoning
    ):

        risks = []

        warning = dynamic_reasoning.get(
            "strategic_warning"
        )

        if warning:

            risks.append(
                warning
            )

        for item in executive_synthesis.get(
            "risks",
            []
        ):

            if item not in risks:

                risks.append(
                    item
                )

        return risks


response_composer_engine = (
    ResponseComposerEngine()
)